---
import ProjectLogo from "@/components/project-logo.astro";
import CostbaseMock from "@/components/mocks/costbase-mock.astro";
import EmbarkMock from "@/components/mocks/embark-mock.astro";
import SageMock from "@/components/mocks/sage-mock.astro";
import type { Project } from "@/constants/projects";

type Props = {
  project: Project;
  /** Put the preview on the left, for alternating rows. */
  flip?: boolean;
};

const MOCKS = {
  costbase: CostbaseMock,
  embark: EmbarkMock,
  sage: SageMock,
} as const;

const { project, flip = false } = Astro.props;
const Mock = MOCKS[project.id];
---

<article
  id={project.id}
  aria-labelledby={`${project.id}-title`}
  class="scroll-mt-20 border-b border-line last:border-0">
  <div
    class:list={[
      "container grid items-center gap-12 py-20 sm:py-24 lg:gap-20",
      flip ? "lg:grid-cols-[7fr_5fr]" : "lg:grid-cols-[5fr_7fr]",
    ]}>
    <div class:list={["max-w-xl", flip && "lg:order-2"]}>
      <div class="flex items-center gap-4">
        <ProjectLogo id={project.id} name={project.name} size={52} />
        <h2 id={`${project.id}-title`} class="display text-2xl sm:text-3xl">{project.name}</h2>
      </div>

      <p class="mt-6 text-xl leading-snug text-fg">{project.summary}</p>
      <p class="mt-3 leading-relaxed text-muted">{project.description}</p>

      <ul class="mt-6 space-y-2.5">
        {
          project.highlights.map((point) => (
            <li class="flex gap-3 text-[15px] leading-relaxed text-muted">
              <span
                class="mt-2.5 size-1.5 shrink-0 rounded-full"
                style={`background:${project.color}`}
                aria-hidden="true"
              />
              {point}
            </li>
          ))
        }
      </ul>

      <p class="sr-only">Built with {project.stack.join(", ")}.</p>
      <ul class="mt-7 flex flex-wrap gap-1.5" aria-hidden="true">
        {
          project.stack.map((tech) => (
            <li class="rounded-md border border-line bg-white/[0.03] px-2 py-1 text-xs text-muted">
              {tech}
            </li>
          ))
        }
      </ul>

      <div class="mt-8">
        {
          project.url && (
            <a href={project.url} class="button-primary mr-3">
              Open {project.name}
            </a>
          )
        }
        {
          project.repository ? (
            <a href={project.repository} class="button-ghost" rel="noopener">
              View source on GitHub
            </a>
          ) : (
            <p class="text-sm text-faint">Private repository.</p>
          )
        }
      </div>
    </div>

    <div class:list={["min-w-0", flip && "lg:order-1"]}>
      <Mock />
    </div>
  </div>
</article>
