---
import LighthouseScores from "@/components/islands/lighthouse-scores.svelte";

type Props = {
  class?: string;
  /** Optional caption under the card. */
  caption?: string;
};
const { class: className = "", caption } = Astro.props;

// This site's own Lighthouse results: mobile, Lighthouse 13, simulated slow 4G, brotli.
// Used on the home page and in the Astro + Cloudflare article, so re-measure and
// update here after changes that add weight to the home page.
const SCORES = [
  { label: "Performance", value: 100 },
  { label: "Accessibility", value: 100 },
  { label: "Best practices", value: 100 },
  { label: "SEO", value: 100 },
];

const METRICS = [
  { label: "Largest paint", value: "1.5 s" },
  { label: "Blocking time", value: "0 ms" },
  { label: "Layout shift", value: "0" },
  { label: "Page weight", value: "73 KB" },
];
---

<figure class:list={[className]}>
<div class="rounded-xl border border-line-strong bg-surface p-6 sm:p-8">
  <LighthouseScores client:visible scores={SCORES} />
  <dl
    class="mx-auto mt-8 grid w-fit grid-cols-2 gap-x-10 gap-y-4 border-t border-line pt-6 sm:grid-cols-4 sm:gap-x-8">
    {
      METRICS.map((m) => (
        <div>
          <dt class="text-xs text-faint">{m.label}</dt>
          <dd class="mt-1 font-mono text-sm tabular-nums text-fg">{m.value}</dd>
        </div>
      ))
    }
  </dl>
</div>
{caption && <figcaption class="mt-3 text-center text-sm text-faint">{caption}</figcaption>}
</figure>
