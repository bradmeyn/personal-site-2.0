---
import type { Project } from "@/constants/projects";
type Props = {
  project: Project;
  index: number;
};

const { project, index } = Astro.props;
const { title, description, repository } = project;
const num = String(index + 1).padStart(2, "0");
---

<a
  href={repository}
  target="_blank"
  rel="noopener noreferrer"
  class="group grid grid-cols-[2.5rem_1fr_auto] sm:grid-cols-[3rem_1fr_auto] items-center gap-x-4 gap-y-1 border-b border-line py-7">
  <span class="font-mono text-sm text-ink-400 group-hover:text-accent-500 transition-colors duration-300">
    {num}
  </span>

  <div class="min-w-0">
    <h3
      class="font-display text-xl sm:text-2xl text-ink-950 transition-transform duration-300 group-hover:translate-x-1">
      {title}
    </h3>
    <p class="mt-1 text-ink-600 leading-relaxed">
      {description}
    </p>
  </div>

  <div
    class="flex items-center gap-2 text-ink-600 group-hover:text-accent-600 transition-colors duration-300">
    <span
      class="hidden sm:inline font-mono text-xs tracking-wide uppercase"
      >View</span
    >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-5 -rotate-45 transition-transform duration-300 group-hover:rotate-0">
      <path d="M5 12h14"></path>
      <path d="m12 5 7 7-7 7"></path>
    </svg>
  </div>
</a>
