---
import PageHead from "./page-head.astro";

const year = new Date().getFullYear();

const { title } = Astro.props || {};
---

<html lang="en" data-theme="dark">
  <head>
    <PageHead title={title} />
  </head>

  <body class="antialiased">
    <div
      class="flex flex-col min-h-screen dark:bg-ui-900 dark:text-white bg-ui-200">
      <div
        class="grow opacity-0 animate-fade-down [animation-fill-mode:forwards]">
        <slot />
      </div>
      <footer>
        <div class="container">
          <div class="flex justify-center py-6">
            <p class="text-sm">
              &#x24B8; Copyright {year} Bradley Meyn. All rights reserved.
            </p>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
