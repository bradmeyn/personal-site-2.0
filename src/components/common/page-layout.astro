---
import PageHead, { type HeadProps } from "./page-head.astro";
import SiteMark from "@/components/site-mark.astro";
import Newcastle from "@/components/newcastle.astro";
import { SITE } from "@/constants/site";

type Props = HeadProps;

const year = new Date().getFullYear();
const path = Astro.url.pathname;
const NAV = [
  { href: "/about/", label: "About" },
  { href: "/projects/", label: "Projects" },
  { href: "/articles/", label: "Articles" },
];
const current = (href: string) => path === href || (href !== "/" && path.startsWith(href));
---

<html lang="en-AU">
  <head>
    <PageHead {...Astro.props} />
  </head>

  <body class="min-h-screen antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-fg focus:px-4 focus:py-2 focus:text-sm focus:text-bg">
      Skip to content
    </a>

    <div class="flex min-h-screen flex-col">
      <header
        class="sticky top-0 z-40 border-b border-line bg-bg/75 backdrop-blur-xl backdrop-saturate-150">
        <div class="container flex h-14 items-center justify-between">
          <a href="/" class="group flex items-center gap-2.5">
            <SiteMark size={30} class="transition-transform duration-200 group-hover:-rotate-6" />
            <span class="hidden font-mono text-sm font-medium tracking-tight sm:inline">{SITE.shortName}</span>
            <span class="sr-only sm:hidden">{SITE.shortName}</span>
          </a>

          <nav aria-label="Primary" class="flex items-center gap-4 sm:gap-6">
            {
              NAV.map((item) => (
                <a
                  href={item.href}
                  aria-current={current(item.href) ? "page" : undefined}
                  class="link text-sm aria-[current=page]:text-fg">
                  {item.label}
                </a>
              ))
            }
            <a href={`mailto:${SITE.email}`} class="button-ghost hidden !py-1.5 sm:inline-flex">
              Email me
            </a>
          </nav>
        </div>
      </header>

      <main id="main" class="grow">
        <slot />
      </main>

      <footer class="border-t border-line">
        <div
          class="container flex flex-col gap-3 py-8 text-sm text-faint sm:flex-row sm:items-center sm:justify-between">
          <p>© {year} {SITE.name}. <Newcastle />, Australia.</p>
          <div class="flex gap-5">
            <a href={`mailto:${SITE.email}`} class="link">Email</a>
            <a href={SITE.github} class="link" rel="me noopener">GitHub</a>
            <a href={SITE.linkedin} class="link" rel="me noopener">LinkedIn</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
