---
import type { CollectionEntry } from "astro:content";

type Props = {
  post: CollectionEntry<"posts">;
  /** Heading level for the title, so it follows the page's outline. */
  headingLevel?: 2 | 3;
};

const { post, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
const { title, outline, date } = post.data;
---

<a
  href={`/articles/${post.id}/`}
  class="group grid gap-x-10 gap-y-2 border-b border-line py-7 sm:grid-cols-[9rem_1fr]">
  <time datetime={date.toISOString()} class="pt-1 text-sm text-faint">
    {date.toLocaleDateString("en-AU", { day: "numeric", month: "short", year: "numeric" })}
  </time>
  <div class="min-w-0">
    <Heading
      class="display text-xl leading-snug text-fg transition-colors duration-200 group-hover:text-accent">
      {title}
    </Heading>
    <p class="mt-2 max-w-[60ch] leading-relaxed text-muted">{outline}</p>
  </div>
</a>
