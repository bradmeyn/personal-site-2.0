---
const { post } = Astro.props;
---

<a
  href={`/posts/${post.id}`}
  class="card group block transition-colors duration-300 hover:border-ui-600 hover:from-ui-800/80">
  <time
    datetime={post.data.date.toISOString()}
    class="text-sm text-ui-400">
    {
      new Date(post.data.date).toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
      })
    }
  </time>

  <h3 class="mt-1 font-serif text-lg text-white line-clamp-2">
    {post.data.title}
  </h3>

  <p class="mt-1 text-ui-300 leading-relaxed line-clamp-2">
    {post.data.outline}
  </p>

  <div class="mt-4 flex items-center gap-2 text-primary-600">
    <span class="text-sm font-semibold">Read</span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-4 transition-transform duration-300 group-hover:translate-x-1">
      <path d="M5 12h14"></path>
      <path d="m12 5 7 7-7 7"></path>
    </svg>
  </div>
</a>
