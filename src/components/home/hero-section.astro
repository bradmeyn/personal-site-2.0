---
import HeroCanvas from "@/components/home/hero-canvas.astro";
import { SITE } from "@/constants/site";
---

<section class="relative isolate overflow-hidden" aria-labelledby="hero-title">
  <!-- Backdrop: a soft violet glow, with the animated silk gradient drawn over it. -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="hero-glow hero-glow-a"></div>
    <HeroCanvas />
    <div class="hero-beam absolute inset-x-0 top-0 h-px"></div>
  </div>

  <div class="container pb-24 pt-24 sm:pb-32 sm:pt-32 lg:pb-40 lg:pt-40">
    <h1
      id="hero-title"
      class="max-w-[18ch] text-balance font-mono text-[2.5rem] font-medium leading-[1.05] tracking-[-0.05em] sm:text-6xl lg:text-[4.75rem]">
      Modern software solutions.
    </h1>

    <p class="mt-8 max-w-[54ch] text-lg leading-relaxed text-muted">
      I'm Brad, a full-stack developer in Newcastle, Australia. I design web apps and build them with
      AI coding agents, mostly in TypeScript with SvelteKit, React and Astro.
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-3">
      <a href="#services" class="button-primary">See what I do</a>
      <a href={SITE.github} class="button-ghost" rel="me noopener">GitHub profile</a>
    </div>
  </div>
</section>
