---
const GITHUB_URL = "https://github.com/bradmeyn";
---

<section class="pt-12 lg:pt-16">
  <div class="flex items-center gap-5">
    <img
      src="/assets/cartoon-brad.png"
      alt="Illustration of Bradley Meyn"
      width="80"
      height="80"
      loading="eager"
      class="size-16 sm:size-20 shrink-0 rounded-full object-cover object-[40%_22%] ring-1 ring-ui-800"
    />

    <div class="space-y-1">
      <h1 class="font-serif text-2xl sm:text-3xl text-white">Bradley Meyn</h1>
      <p class="text-ui-400">
        Full-stack software developer based in Newcastle, Australia.
      </p>
      <a
        href={GITHUB_URL}
        class="inline-block pt-2 text-sm text-ui-400 underline decoration-ui-600 decoration-1 underline-offset-4 transition-colors duration-300 hover:text-white hover:decoration-primary-400">
        github.com/bradmeyn
      </a>
    </div>
  </div>
</section>
