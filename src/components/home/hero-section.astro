---
const GITHUB_URL = "https://github.com/bradmeyn";
// TODO: swap in your real contact email — placeholder for now.
const EMAIL = "hello@bradmeyn.com";
---

<section class="pt-16 sm:pt-24 pb-14 sm:pb-20">
  <div class="flex items-center gap-2.5">
    <span class="size-1.5 rounded-full bg-accent-500"></span>
    <p class="eyebrow">Available for work — Newcastle, AU</p>
  </div>

  <h1
    class="mt-7 font-display font-normal leading-[0.95] tracking-tight text-ink-950 text-[15vw] sm:text-[7.5rem] lg:text-[8.5rem]">
    Bradley
    <br />
    <span class="text-accent-500">Meyn</span>
  </h1>

  <div
    class="mt-10 sm:mt-12 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-8 border-t border-line pt-7">
    <p class="max-w-md text-lg text-ink-700 leading-relaxed">
      Full-stack software developer who builds fast, considered products —
      from financial tools to travel planners. Currently shipping with
      TypeScript, Svelte &amp; Astro.
    </p>

    <div class="flex shrink-0 items-center gap-4">
      <img
        src="/assets/cartoon-brad.png"
        alt="Illustration of Bradley Meyn at his desk"
        width="56"
        height="56"
        loading="eager"
        class="size-12 shrink-0 rounded-full object-cover object-[40%_22%] grayscale contrast-125"
      />
      <div class="h-8 w-px bg-line" aria-hidden="true"></div>
      <nav class="flex items-center gap-5 text-sm text-ink-600">
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-accent-600 transition-colors duration-200">
          GitHub
        </a>
        <a
          href={`mailto:${EMAIL}`}
          class="hover:text-accent-600 transition-colors duration-200">
          Email
        </a>
      </nav>
    </div>
  </div>
</section>
