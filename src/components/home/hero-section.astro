---
import HeroCanvas from "@/components/home/hero-canvas.astro";
import Newcastle from "@/components/newcastle.astro";
import { SITE } from "@/constants/site";
---

<section
  class="relative isolate flex items-center overflow-hidden sm:min-h-[calc(100svh-3.5rem)]"
  aria-labelledby="hero-title">
  <!-- Backdrop: the animated circuit grid, or a static CSS grid on phones. -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="hero-grid absolute inset-0 sm:hidden"></div>
    <HeroCanvas />
  </div>

  <div class="container py-20 sm:text-center">
    <h1
      id="hero-title"
      class="font-mono text-[2.125rem] font-medium leading-[1.05] tracking-[-0.05em] sm:text-5xl lg:text-[4.25rem]">
      <span class="block">Modern software,</span>
      <!-- Wraps only between the two phrases, never mid-phrase. -->
      <span class="block"
        ><span class="inline-block">from plan</span>{" "}<span class="inline-block"
          >to production.<span class="typed-cursor" aria-hidden="true"></span></span
        ></span
      >
    </h1>

    <p class="mt-8 max-w-[56ch] text-pretty text-lg leading-relaxed text-muted sm:mx-auto">
      I'm Brad, a full-stack developer in <Newcastle />, Australia.{" "}<br class="hidden sm:inline" />
      I build applications, internal tools &amp; websites.
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-3 sm:justify-center">
      <a href="#services" class="button-primary">See what I do</a>
      <a href={SITE.github} class="button-ghost" rel="me noopener">GitHub profile</a>
    </div>
  </div>
</section>
