---
import ProjectLogo from "@/components/project-logo.astro";
import CostbaseMock from "@/components/mocks/costbase-mock.astro";
import EmbarkMock from "@/components/mocks/embark-mock.astro";
import SageMock from "@/components/mocks/sage-mock.astro";
import { PROJECTS } from "@/constants/projects";

const MOCKS = {
  costbase: CostbaseMock,
  embark: EmbarkMock,
  sage: SageMock,
} as const;
---

<!--
  One section that cycles through the projects as tabs. Every panel is in the HTML;
  the script below only switches which one is visible. Each tab's progress bar is a
  CSS animation, and the panel advances when it ends, so pausing the animation pauses
  the cycle.
-->
<section
  id="projects"
  aria-labelledby="projects-title"
  class="scroll-mt-20 border-t border-line"
  data-projects
  data-auto="true">
  <div class="container py-20 sm:py-28">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 id="projects-title" class="display text-3xl leading-tight sm:text-4xl">My projects</h2>
      <a href="/projects/" class="link text-sm">All projects</a>
    </div>

    <div role="tablist" aria-label="Projects" class="mt-10 grid grid-cols-3 gap-3 sm:gap-6">
      {
        PROJECTS.map((project, i) => (
          <button
            type="button"
            role="tab"
            id={`${project.id}-tab`}
            aria-controls={project.id}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            class="project-tab group flex min-w-0 flex-col justify-start text-left">
            <span class="block h-0.5 overflow-hidden rounded-full bg-line-strong">
              <span class="progress-bar block h-full rounded-full bg-accent" data-bar />
            </span>
            <span class="mt-4 flex flex-col items-start gap-2 sm:flex-row sm:items-center sm:gap-4">
              <span class="relative isolate">
                <span
                  class="project-tab-glow pointer-events-none absolute -inset-3 -z-10 rounded-full blur-xl"
                  style={`background:${project.color}`}
                  aria-hidden="true"
                />
                <ProjectLogo id={project.id} name={project.name} size={44} class="project-tab-logo" />
              </span>
              <span class="truncate font-mono text-sm font-medium tracking-tight sm:text-xl">
                {project.name}
              </span>
            </span>
          </button>
        ))
      }
    </div>

    <div class="mt-12 grid sm:mt-16">
      {
        PROJECTS.map((project, i) => {
          const Mock = MOCKS[project.id];
          return (
            <div
              id={project.id}
              role="tabpanel"
              aria-labelledby={`${project.id}-tab`}
              data-panel
              data-active={i === 0 ? "true" : "false"}
              class="project-panel grid scroll-mt-28 content-start items-start gap-12 lg:grid-cols-[5fr_7fr] lg:gap-16">
              <div class="max-w-xl">
                {/* The tab already shows the name on larger screens. */}
                <h3 class="display text-2xl sm:sr-only">{project.name}</h3>
                <p class="mt-3 text-xl leading-snug text-fg sm:mt-0">{project.summary}</p>
                <p class="mt-3 leading-relaxed text-muted">{project.description}</p>

                <ul class="mt-6 space-y-2.5">
                  {project.highlights.map((point) => (
                    <li class="flex gap-3 text-[15px] leading-relaxed text-muted">
                      <span
                        class="mt-2.5 size-1.5 shrink-0 rounded-full"
                        style={`background:${project.color}`}
                        aria-hidden="true"
                      />
                      {point}
                    </li>
                  ))}
                </ul>

                <p class="sr-only">Built with {project.stack.join(", ")}.</p>
                <ul class="mt-7 flex flex-wrap gap-1.5" aria-hidden="true">
                  {project.stack.map((tech) => (
                    <li class="rounded-md border border-line bg-white/[0.03] px-2 py-1 text-xs text-muted">
                      {tech}
                    </li>
                  ))}
                </ul>

                <div class="mt-8">
                  {project.url && (
                    <a href={project.url} class="button-primary mr-3">
                      Open {project.name}
                    </a>
                  )}
                  {project.repository ? (
                    <a href={project.repository} class="button-ghost" rel="noopener">
                      View source on GitHub
                    </a>
                  ) : (
                    <p class="text-sm text-faint">Private repository.</p>
                  )}
                </div>
              </div>

              <div class="min-w-0">
                <Mock />
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-projects]");

  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];
    const ids = panels.map((panel) => panel.id);
    let active = 0;

    const setAuto = (on: boolean) => (root.dataset.auto = String(on));
    const isAuto = () => root.dataset.auto === "true";

    function restartBar() {
      for (const tab of tabs) tab.querySelector("[data-bar]")?.classList.remove("is-running");
      if (!isAuto()) return;
      const bar = tabs[active].querySelector<HTMLElement>("[data-bar]");
      if (!bar) return;
      void bar.offsetWidth; // restart the CSS animation
      bar.classList.add("is-running");
    }

    function activate(index: number, { user = false, focus = false } = {}) {
      active = (index + tabs.length) % tabs.length;
      tabs.forEach((tab, i) => {
        const on = i === active;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
      });
      panels.forEach((panel, i) => {
        const on = i === active;
        panel.dataset.active = String(on);
        panel.inert = !on;
      });
      if (user) setAuto(false);
      if (focus) tabs[active].focus();
      restartBar();
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => activate(i, { user: true }));
      tab.querySelector("[data-bar]")?.addEventListener("animationend", () => {
        if (isAuto()) activate(active + 1);
      });
    });

    root.querySelector('[role="tablist"]')?.addEventListener("keydown", (event) => {
      const key = (event as KeyboardEvent).key;
      const moves: Record<string, number> = {
        ArrowRight: active + 1,
        ArrowLeft: active - 1,
        Home: 0,
        End: tabs.length - 1,
      };
      if (!(key in moves)) return;
      event.preventDefault();
      activate(moves[key], { user: true, focus: true });
    });

    // Pause while someone is reading or interacting, and while the section is off screen.
    const pause = (on: boolean) => (root.dataset.paused = String(on));
    root.addEventListener("pointerenter", () => pause(true));
    root.addEventListener("pointerleave", () => pause(false));
    root.addEventListener("focusin", () => pause(true));
    root.addEventListener("focusout", () => pause(false));
    new IntersectionObserver(([entry]) => {
      root.dataset.visible = String(entry.isIntersecting);
    }, { threshold: 0.35 }).observe(root);

    // Links like /#costbase (hero icons, services) open the matching project.
    function fromHash() {
      const index = ids.indexOf(location.hash.slice(1));
      if (index === -1) return;
      activate(index, { user: true });
      root.scrollIntoView();
    }
    window.addEventListener("hashchange", fromHash);

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) setAuto(false);
    panels.forEach((panel, i) => (panel.inert = i !== 0));
    fromHash();
    restartBar();
  }
</script>
