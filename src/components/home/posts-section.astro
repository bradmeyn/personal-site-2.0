---
import PostCard from "@/components/post-card.astro";
import { getPosts } from "@/lib/posts";

const LIMIT = 3;
const posts = await getPosts();
---

<section id="articles" aria-labelledby="articles-title" class="scroll-mt-20 border-t border-line">
  <div class="container py-20 sm:py-28">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 id="articles-title" class="display text-3xl leading-tight sm:text-4xl" data-type-on-scroll>Articles</h2>
      <a href="/articles/" class="link text-sm">All articles</a>
    </div>
    <div class="mt-8 border-t border-line">
      {posts.slice(0, LIMIT).map((post) => <PostCard post={post} />)}
    </div>
  </div>
</section>
