---
const capabilities = [
  {
    title: "Web Apps",
    description:
      "Modern, fast, accessible front-ends with clean component architecture and solid testing.",
    icon: `<path d="M2 4h20v14H2z"/><path d="M2 8h20"/><path d="M6 18v3"/><path d="M18 18v3"/><path d="M5 21h14"/>`,
  },
  {
    title: "API Integrations",
    description:
      "Connect third-party services and internal systems with reliable, well-tested integrations.",
    icon: `<path d="M10 13a5 5 0 0 0 7.07 0l2.83-2.83a5 5 0 0 0-7.07-7.07L11 4"/><path d="M14 11a5 5 0 0 0-7.07 0L4.1 13.83a5 5 0 1 0 7.07 7.07L13 20"/>`,
  },
  {
    title: "Cloud & DevOps",
    description:
      "AWS deployments, CI/CD pipelines, and infrastructure built for reliability and easy handoff.",
    icon: `<path d="M17.5 19a4.5 4.5 0 1 0-1.4-8.78 6 6 0 1 0-10.6 4.78"/><path d="M12 19v3"/><path d="M9 22h6"/>`,
  },
  {
    title: "Mobile",
    description:
      "Cross-platform mobile experiences with pragmatic architecture and a clear release plan.",
    icon: `<rect x="7" y="2" width="10" height="20" rx="2"/><line x1="11" y1="18" x2="13" y2="18"/>`,
  },
  {
    title: "AI Features",
    description:
      "Assistants, semantic search, and workflow automation built on top of modern LLM APIs.",
    icon: `<path d="m12 3 1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z"/><path d="m19 14 1 2.5L22.5 17 20 18l-1 2.5L18 18l-2.5-1 2.5-.5z"/>`,
  },
  {
    title: "MVP Builds",
    description:
      "End-to-end MVPs taken from concept to production launch in tight, focused iterations.",
    icon: `<path d="M4.5 16.5c-1.5 1.5-1 4-1 4s2.5.5 4-1l3-3-3-3z"/><path d="M14 10 9 5c3-3 7.5-3 10-1 2 2 2 7-1 10l-4 4"/><path d="M15 9l-6 6"/>`,
  },
];

---

<section
  class="animate-fade-down opacity-0 [animation-delay:0.6s] [animation-fill-mode:forwards]"
>
  <h2 class="heading--secondary">What I work on</h2>

  <div class="space-y-12">
    <div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          capabilities.map((capability) => (
            <article class="card space-y-3">
              <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-lg border border-ui-700/50 bg-ui-900/50 text-primary-500">
                  <svg
                    viewBox="0 0 24 24"
                    class="size-5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={capability.icon}
                  />
                </div>
                <h4 class="text-xl font-serif text-white">
                  {capability.title}
                </h4>
              </div>
              <p class="text-ui-300 text-sm leading-relaxed">
                {capability.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>

  </div>
</section>
