---
import CrmDemo from "@/components/islands/crm-demo.svelte";
import DashboardDemo from "@/components/islands/dashboard-demo.svelte";
import LighthouseCard from "@/components/lighthouse-card.astro";
---

<section id="services" aria-labelledby="services-title" class="scroll-mt-20 border-t border-line">
  <div class="container py-20 sm:py-28">
    <h2 id="services-title" class="display text-3xl leading-tight sm:text-4xl" data-type-on-scroll>What I do</h2>

    <article
      aria-labelledby="applications-title"
      class="mt-14 grid items-center gap-12 lg:grid-cols-[2fr_3fr] lg:gap-16">
      <div class="max-w-md">
        <h3 id="applications-title" class="display text-2xl leading-tight sm:text-3xl">
          Business applications
        </h3>
        <p class="mt-5 text-lg leading-relaxed text-muted">
          The complex software a business depends on every day: client records, compliance, pipelines
          and the workflows that tie them together. Built to be fast, reliable and simple for the
          people who use it all day.
        </p>
        <p class="mt-6 text-sm text-muted">
          In production:{" "}
          <a href="#sage" class="text-fg underline decoration-line-strong underline-offset-4 transition-colors hover:text-accent hover:decoration-accent">Sage</a>.
        </p>
      </div>
      <CrmDemo client:visible />
    </article>

    <article
      aria-labelledby="dashboards-title"
      class="mt-32 grid items-center gap-12 lg:grid-cols-[3fr_2fr] lg:gap-16">
      <div class="max-w-md lg:order-2">
        <h3 id="dashboards-title" class="display text-2xl leading-tight sm:text-3xl">
          Professional dashboards
        </h3>
        <p class="mt-5 text-lg leading-relaxed text-muted">
          The numbers a business is run by, made clear: portfolios, reporting and live figures that
          stay fast with years of data behind them, so decisions don't wait on a spreadsheet.
        </p>
        <p class="mt-6 text-sm text-muted">
          In production:{" "}
          <a href="#costbase" class="text-fg underline decoration-line-strong underline-offset-4 transition-colors hover:text-accent hover:decoration-accent">Costbase</a>.
        </p>
      </div>
      <div class="lg:order-1"><DashboardDemo client:visible /></div>
    </article>

    <article
      aria-labelledby="marketing-title"
      class="mt-32 grid items-center gap-12 lg:grid-cols-[2fr_3fr] lg:gap-16">
      <div class="max-w-md">
        <h3 id="marketing-title" class="display text-2xl leading-tight sm:text-3xl">
          Fast, findable websites
        </h3>
        <p class="mt-5 text-lg leading-relaxed text-muted">
          Websites that load instantly, show up in search and cost next to nothing to host. Built
          with modern technology instead of WordPress, so there are no plugins to patch and nothing
          slowing it down. These scores are this site's own.
        </p>
        <p class="mt-6 text-sm text-muted">
          Read how:{" "}
          <a
            href="/articles/astro-cloudflare-marketing-site/"
            class="text-fg underline decoration-line-strong underline-offset-4 transition-colors hover:text-accent hover:decoration-accent">
            Astro + Cloudflare for your marketing site</a
          >.
        </p>
      </div>

      <LighthouseCard class="lg:[&>div]:aspect-[7/5]" />
    </article>
  </div>
</section>
