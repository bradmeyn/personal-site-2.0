---
type Props = {
  href: string;
  title?: string;
};

const { href, title } = Astro.props;
const external = /^https?:\/\//.test(href);
---

<a
  href={href}
  title={title}
  {...external && { target: "_blank", rel: "noopener noreferrer" }}
  class="text-ink-900 underline underline-offset-4 decoration-line-strong decoration-1 hover:decoration-accent-500 hover:text-accent-600 transition-colors duration-200"
>
  <slot />
</a>
