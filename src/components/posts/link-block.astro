---
type Props = {
  href: string;
  title?: string;
};

const { href, title } = Astro.props;
const external = /^https?:\/\//.test(href);
---

<a
  href={href}
  title={title}
  {...external && { target: "_blank", rel: "noopener noreferrer" }}
  class="text-ui-100 underline underline-offset-4 decoration-ui-600 decoration-1 hover:decoration-primary-400 hover:text-white transition-colors duration-200"
>
  <slot />
</a>
