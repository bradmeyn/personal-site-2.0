---
import { Code } from "astro:components";
import * as icons from "simple-icons";

type Side = { code: string; lang?: string; file?: string };
type Props = {
  /** Left-hand snippet (the one being compared against). */
  next: Side;
  /** Right-hand snippet, highlighted. */
  start: Side;
  /** Panel names; defaults to Next.js and TanStack Start. */
  labels?: [string, string];
  /** simple-icons export names for each panel. */
  icons?: [string, string];
  caption?: string;
};

const {
  next,
  start,
  labels = ["Next.js", "TanStack Start"],
  icons: iconNames = ["siNextdotjs", "siTanstack"],
  caption,
} = Astro.props;

const icon = (name: string) => (icons as Record<string, { path: string }>)[name];
const SIDES = [
  { key: "left", name: labels[0], icon: icon(iconNames[0]), side: next, accent: false },
  { key: "right", name: labels[1], icon: icon(iconNames[1]), side: start, accent: true },
];
---

<figure class="code-compare not-prose my-10 xl:-mx-44">
  <div class="grid gap-3 xl:grid-cols-2">
    {
      SIDES.map(({ name, icon, side, accent }) => (
        <div
          class:list={[
            "min-w-0 overflow-hidden rounded-xl border bg-surface",
            accent ? "border-accent/40" : "border-line-strong",
          ]}>
          <div class="flex items-center gap-2 border-b border-line px-3.5 py-2.5 text-xs">
            <svg viewBox="0 0 24 24" class:list={["size-3.5", accent ? "text-accent" : "text-muted"]} fill="currentColor" aria-hidden="true">
              <path d={icon.path} />
            </svg>
            <span class:list={["shrink-0 whitespace-nowrap font-medium", accent ? "text-fg" : "text-muted"]}>{name}</span>
            {side.file && <span class="ml-auto min-w-0 truncate font-mono text-faint" dir="rtl">{side.file}</span>}
          </div>
          <Code code={side.code.trim()} lang={(side.lang ?? "tsx") as any} theme="github-dark-dimmed" />
        </div>
      ))
    }
  </div>
  {caption && <figcaption class="mt-3 text-center text-sm text-faint">{caption}</figcaption>}
</figure>

<style>
  .code-compare :global(pre) {
    margin: 0;
    border: 0;
    border-radius: 0;
    background: transparent !important;
    font-size: 12px;
    line-height: 1.65;
    padding: 0.9rem 1rem;
    overflow-x: auto;
    white-space: pre;
  }
</style>
