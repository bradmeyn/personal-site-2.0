---
/** A short numbered plan as three cards. */
type Step = { title: string; body: string };
type Props = { steps: Step[] };

const { steps } = Astro.props;
---

<ol class="not-prose my-10 grid gap-3 sm:grid-cols-3">
  {
    steps.map((step, i) => (
      <li class="relative overflow-hidden rounded-xl border border-line-strong bg-surface p-5">
        <span
          class="pointer-events-none absolute -right-2 -top-6 font-mono text-[5.5rem] font-semibold leading-none text-white/[0.04]"
          aria-hidden="true">
          {i + 1}
        </span>
        <span class="font-mono text-xs text-accent">Step {i + 1}</span>
        <p class="mt-2 text-base font-medium leading-snug text-fg">{step.title}</p>
        <p class="mt-2 text-sm leading-relaxed text-muted">{step.body}</p>
      </li>
    ))
  }
</ol>
