---
import MockFrame from "./mock-frame.astro";

// Sage's client record, using the demo household from Sage's own marketing page.
const NAV = [
  { group: "Profile", items: ["Overview", "Fact find", "Goals"] },
  { group: "Financials", items: ["Balance sheet", "Cashflow", "Insurance"] },
  { group: "Advice", items: ["Modelling", "Advice documents"] },
  { group: "Work", items: ["Jobs", "File notes"] },
];

const ACTIVITY = [
  { lead: "Margaret and Paul", rest: "accepted the Statement of Advice online", when: "just now" },
  { lead: "Retirement advice", rest: "moved to Authority to proceed", when: "2 min ago" },
  { lead: "Fact find", rest: "submitted through the client portal", when: "21 Aug" },
];

const DETAILS = [
  { label: "Status", value: "Active" },
  { label: "Net worth", value: "$1.84M" },
  { label: "Ongoing fee", value: "$4,400 a year" },
  { label: "Fee renewal", value: "15 Oct 2026" },
];
---

<MockFrame title="Margaret & Paul Whitfield" color="var(--color-sage)">
  <div class="grid sm:grid-cols-[8.5rem_minmax(0,1fr)] xl:grid-cols-[8.5rem_minmax(0,1fr)_9.5rem]">
    <nav class="hidden border-r border-line bg-bg/40 px-2 py-3 sm:block">
      {
        NAV.map((section) => (
          <div class="mb-3 last:mb-0">
            <p class="px-2 pb-1 text-[10px] text-faint">{section.group}</p>
            {section.items.map((item) => (
              <p
                class:list={[
                  "truncate rounded-md px-2 py-1 text-xs",
                  item === "Overview" ? "bg-white/[0.06] text-fg" : "text-muted",
                ]}>
                {item}
              </p>
            ))}
          </div>
        ))
      }
    </nav>

    <div class="min-w-0 p-4 sm:p-5">
      <div class="flex items-center gap-3">
        <span
          class="grid size-9 shrink-0 place-items-center rounded-full bg-[#4f8f74] text-xs font-semibold text-white">
          MW
        </span>
        <div class="min-w-0">
          <p class="truncate text-base font-medium leading-tight text-fg">Margaret & Paul Whitfield</p>
          <p class="text-xs text-faint">Couple, both 54. Retiring at 62.</p>
        </div>
      </div>

      <div class="mt-3 flex flex-wrap gap-1.5">
        <span class="rounded-md bg-sage/15 px-1.5 py-0.5 text-[11px] text-sage">Retirement</span>
        <span class="rounded-md bg-costbase/15 px-1.5 py-0.5 text-[11px] text-costbase">Super</span>
      </div>

      <p class="mt-5 text-xs font-medium text-muted">Activity</p>
      <ol class="mt-2 space-y-2">
        {
          ACTIVITY.map((a) => (
            <li class="flex gap-2 text-xs leading-relaxed text-muted">
              <span class="mt-[5px] size-1.5 shrink-0 rounded-full bg-sage" />
              <span>
                <span class="font-medium text-fg">{a.lead}</span> {a.rest}
                <span class="whitespace-nowrap text-faint">, {a.when}</span>
              </span>
            </li>
          ))
        }
      </ol>

      <div class="mt-4 rounded-lg border border-line bg-raised p-3">
        <p class="text-xs">
          <span class="font-medium text-fg">Strategy meeting</span>
          <span class="text-faint">, 3 Sep</span>
        </p>
        <p class="mt-1.5 text-xs leading-relaxed text-muted">
          Both want certainty of income from 62. Agreed $12,000 a year salary sacrifice between them
          and rolling Paul's old fund into his main account.
        </p>
      </div>
    </div>

    <dl class="hidden space-y-3 border-l border-line p-4 xl:block">
      {
        DETAILS.map((d) => (
          <div>
            <dt class="text-[11px] text-faint">{d.label}</dt>
            <dd class="mt-0.5 text-xs text-fg">{d.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</MockFrame>
