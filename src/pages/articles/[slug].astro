---
import PageLayout from "@/components/common/page-layout.astro";
import { getPosts } from "@/lib/posts";
import { SITE } from "@/constants/site";
import { render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, outline, date, tags } = entry.data;
const url = new URL(`/articles/${entry.id}/`, SITE.url).href;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description: outline,
    datePublished: date.toISOString(),
    url,
    mainEntityOfPage: url,
    image: new URL("/og.png", SITE.url).href,
    keywords: tags.join(", "),
    inLanguage: "en-AU",
    author: { "@type": "Person", "@id": `${SITE.url}/#person`, name: SITE.name, url: SITE.url },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
      { "@type": "ListItem", position: 2, name: "Articles", item: `${SITE.url}/articles/` },
      { "@type": "ListItem", position: 3, name: title, item: url },
    ],
  },
];
---

<PageLayout
  title={title}
  description={outline}
  type="article"
  article={{ publishedTime: date, tags }}
  jsonLd={jsonLd}>
  <article class="container max-w-[46rem] pb-24 pt-12 sm:pt-16">
    <nav aria-label="Breadcrumb">
      <a href="/articles/" class="link inline-flex items-center gap-2 text-sm">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4"
          aria-hidden="true">
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
        All articles
      </a>
    </nav>

    <header class="mb-12 mt-10 border-b border-line pb-10">
      <h1 class="display text-balance text-3xl leading-[1.15] sm:text-4xl">{title}</h1>
      <p class="mt-5 text-lg leading-relaxed text-muted">{outline}</p>
      <p class="mt-6 text-sm text-faint">
        By {SITE.name},{" "}
        <time datetime={date.toISOString()}>
          {date.toLocaleDateString("en-AU", { day: "numeric", month: "long", year: "numeric" })}
        </time>
      </p>
    </header>

    <div class="article-body">
      <Content />
    </div>
  </article>
</PageLayout>
