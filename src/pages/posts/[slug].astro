---
import PageLayout from "@/components/common/page-layout.astro";
import { getCollection, render } from "astro:content";

// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}
// 2. For your template, you can get the entry directly from the prop
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<PageLayout title={entry.data.title}>
  <main class="py-4 mx-auto px-4 max-w-2xl">
    <a
      href={"/"}
      class="flex w-fit items-center gap-3 text-ui-400 hover:text-primary-700 transition-all duration-300 group py-3">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="transform transition-all duration-300 group-hover:text-primary-700 size-5">
        <path d="M19 12H5"></path>
        <path d="m12 19-7-7 7-7"></path>
      </svg>
      <span class="font-medium">Home</span>
    </a>
    <div class="mb-10">
      <time
        datetime={entry.data.date.toISOString()}
        class="block mb-2 text-ui-500 text-sm">
        {
          new Date(entry.data.date).toLocaleDateString("en-US", {
            month: "short",
            day: "numeric",
            year: "numeric",
          })
        }
      </time>
      <h1 class="font-serif text-2xl sm:text-3xl text-white">
        {entry.data.title}
      </h1>
    </div>
    <div class="article-body">
      <Content />
    </div>
  </main>
</PageLayout>
