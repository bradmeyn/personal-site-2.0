---
import PageLayout from "@/components/common/page-layout.astro";
---

<PageLayout title="Page not found" description="This page doesn't exist." noindex>
  <section class="container py-28 sm:py-40">
    <h1 class="display text-4xl sm:text-5xl">Page not found</h1>
    <p class="mt-5 max-w-[48ch] text-lg text-muted">
      The page may have moved, or the link has a typo in it.
    </p>
    <a href="/" class="button-primary mt-10">Go to the home page</a>
  </section>
</PageLayout>
