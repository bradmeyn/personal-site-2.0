---
import { Image } from "astro:assets";
import PageLayout from "@/components/common/page-layout.astro";
import { SITE } from "@/constants/site";
import profile from "@/assets/profile-family.jpg";
import TechWall from "@/components/tech-wall.astro";
import Newcastle from "@/components/newcastle.astro";

const QUALIFICATIONS = [
  {
    title: "AWS Certified Cloud Practitioner",
    institution: "Amazon Web Services",
    year: 2024,
  },
  {
    title: "Master of Computer Science, with Distinction",
    institution: "Monash University",
    year: 2022,
  },
  {
    title: "Bachelor of Business & Commerce, with Distinction",
    institution: "University of Newcastle",
    year: 2014,
  },
];


// What the About page lists up top: experience, then qualifications.
const HIGHLIGHTS = [
  { title: "4+ years as a software developer" },
  { title: "Master of Computer Science", detail: "Monash University, with Distinction" },
  {
    title: "Bachelor of Business & Commerce",
    detail: "University of Newcastle, with Distinction",
  },
  { title: "AWS Certified Cloud Practitioner", detail: "Amazon Web Services" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    url: `${SITE.url}/about/`,
    mainEntity: {
      "@type": "Person",
      "@id": `${SITE.url}/#person`,
      name: SITE.name,
      jobTitle: "Full-stack developer",
      url: SITE.url,
      sameAs: [SITE.github, SITE.linkedin],
      alumniOf: [
        { "@type": "CollegeOrUniversity", name: "Monash University" },
        { "@type": "CollegeOrUniversity", name: "University of Newcastle" },
      ],
      hasCredential: QUALIFICATIONS.map((q) => ({
        "@type": "EducationalOccupationalCredential",
        name: q.title,
        recognizedBy: { "@type": "Organization", name: q.institution },
      })),
    },
  },
];
---

<PageLayout
  title="About"
  description="Bradley Meyn is a full-stack developer in Newcastle, Australia, with over four years of experience, a Master of Computer Science from Monash University and a Bachelor of Business & Commerce from the University of Newcastle."
  jsonLd={jsonLd}>
  <section class="container pb-20 pt-16 sm:pt-24">
    <div class="grid items-start gap-12 lg:grid-cols-[3fr_2fr] lg:gap-20">
      <div>
        <h1 class="display text-4xl leading-tight sm:text-5xl">About</h1>
        <p class="mt-8 max-w-[60ch] text-lg leading-relaxed text-muted">
          Hi, I'm Brad, a full-stack developer in <Newcastle />, Australia. I build applications,
          internal tools &amp; websites, mostly in TypeScript with SvelteKit, React and Astro.
        </p>

        <ul class="mt-8 max-w-[60ch] divide-y divide-line border-y border-line">
          {
            HIGHLIGHTS.map((h) => (
              <li class="flex gap-4 py-4">
                <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                <span>
                  <span class="block font-medium text-fg">{h.title}</span>
                  {h.detail && (
                    <span class="mt-0.5 block text-sm text-muted">
                      {h.detail.startsWith("University of Newcastle") ? (
                        <>
                          University of <Newcastle />
                          {h.detail.slice("University of Newcastle".length)}
                        </>
                      ) : (
                        h.detail
                      )}
                    </span>
                  )}
                </span>
              </li>
            ))
          }
        </ul>

        <p class="mt-8 max-w-[60ch] text-lg leading-relaxed text-muted">
          Outside of work I play guitar, stay active and spend time with my family.
        </p>

        <div class="mt-10 flex flex-wrap gap-3">
          <a href={`mailto:${SITE.email}`} class="button-primary">Email me</a>
          <a href={SITE.linkedin} class="button-ghost" rel="me noopener">LinkedIn</a>
          <a href={SITE.github} class="button-ghost" rel="me noopener">GitHub</a>
        </div>
      </div>

      <figure class="lg:pt-4">
        <Image
          src={profile}
          alt="Brad with his family outside a winery"
          widths={[360, 540, 720]}
          sizes="(min-width: 1024px) 420px, (min-width: 640px) 560px, 92vw"
          quality={55}
          format="avif"
          fetchpriority="high"
          class="aspect-[4/5] w-full rounded-xl border border-line-strong object-cover object-top"
          loading="eager"
        />
      </figure>
    </div>
  </section>

  <section aria-labelledby="tools-title" class="border-t border-line">
    <div class="container grid gap-10 py-20 lg:grid-cols-[1fr_2fr]">
      <div>
        <h2 id="tools-title" class="display text-2xl sm:text-3xl">Tools I've worked with</h2>
        <p class="mt-4 max-w-[36ch] leading-relaxed text-muted">
          A modern TypeScript stack day to day, with Python, .NET and Swift along the way.
        </p>
      </div>
      <TechWall />
    </div>
  </section>
</PageLayout>
