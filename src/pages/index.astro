---
import PageLayout from "@/components/common/page-layout.astro";
import HeroSection from "@/components/home/hero-section.astro";
import ProjectsSection from "@/components/home/projects-section.astro";
import PostsSection from "@/components/home/posts-section.astro";
import ContactSection from "@/components/home/contact-section.astro";
import ServicesSection from "@/components/home/services-section.astro";
import { PROJECTS } from "@/constants/projects";
import { SITE } from "@/constants/site";

const personId = `${SITE.url}/#person`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${SITE.url}/#website`,
    url: SITE.url,
    name: SITE.name,
    description: SITE.description,
    inLanguage: "en-AU",
    publisher: { "@id": personId },
  },
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    url: SITE.url,
    mainEntity: {
      "@type": "Person",
      "@id": personId,
      name: SITE.name,
      alternateName: SITE.shortName,
      url: SITE.url,
      jobTitle: "Full-stack developer",
      address: {
        "@type": "PostalAddress",
        addressLocality: SITE.location.locality,
        addressRegion: SITE.location.region,
        addressCountry: SITE.location.country,
      },
      sameAs: [SITE.github, SITE.linkedin],
      knowsAbout: ["TypeScript", "SvelteKit", "Svelte", "React", "TanStack Start", "Astro", "PostgreSQL"],
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Projects",
    itemListElement: PROJECTS.map((project, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "SoftwareApplication",
        name: project.name,
        description: project.summary,
        applicationCategory: "WebApplication",
        operatingSystem: "Web",
        url: project.url ?? `${SITE.url}/projects/#${project.id}`,
        ...(project.repository && { codeRepository: project.repository }),
        author: { "@id": personId },
      },
    })),
  },
];
---

<PageLayout jsonLd={jsonLd}>
  <HeroSection />
  <ServicesSection />
  <ProjectsSection />
  <PostsSection />
  <ContactSection />
</PageLayout>
