---
import PageLayout from "@/components/common/page-layout.astro";
import HeroSection from "@/components/home/hero-section.astro";
import ProjectsSection from "@/components/home/projects-section.astro";
import PostsSection from "@/components/home/posts-section.astro";
import ContactSection from "@/components/home/contact-section.astro";
import ServicesSection from "@/components/home/services-section.astro";
import TypeOnScroll from "@/components/type-on-scroll.astro";
import { PROJECTS } from "@/constants/projects";
import { SITE } from "@/constants/site";
import { PERSON, PERSON_ID } from "@/lib/person";

const personId = PERSON_ID;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${SITE.url}/#website`,
    url: SITE.url,
    name: SITE.name,
    description: SITE.description,
    inLanguage: "en-AU",
    publisher: { "@id": personId },
  },
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    url: SITE.url,
    mainEntity: PERSON,
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Projects",
    itemListElement: PROJECTS.map((project, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "SoftwareApplication",
        name: project.name,
        description: project.summary,
        applicationCategory: "WebApplication",
        operatingSystem: "Web",
        url: project.url ?? `${SITE.url}/projects/#${project.id}`,
        ...(project.repository && { codeRepository: project.repository }),
        author: { "@id": personId },
      },
    })),
  },
];
---

<PageLayout jsonLd={jsonLd}>
  <HeroSection />
  <ServicesSection />
  <ProjectsSection />
  <PostsSection />
  <ContactSection />
  <TypeOnScroll />
</PageLayout>
